{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    // Only allow "erasable" TS syntax (type annotations, interfaces, import type...).
    // Why this is required: tests are run by node directly on .ts (v24 strip-only mode),
    // which rejects syntax that needs codegen — enum, namespace, parameter properties
    // (ERR_UNSUPPORTED_TYPESCRIPT_SYNTAX). With this on, such syntax fails at `pnpm check`
    // instead of exploding at runtime. **Burned before**: Bun's node shim tolerates them,
    // so everything was green locally while a real node refused to start.
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "lib": ["ESNext"],
    "types": ["node"]
  },
  "include": ["src/**/*.ts", "e2e/**/*.ts"],
  "exclude": ["**/node_modules/**", "refs/**", "scratch/**"]
}
