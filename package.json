{
  "name": "upassa",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./nanopass": "./src/nanopass/index.ts",
    "./ssa": "./src/ssa/index.ts"
  },
  "scripts": {
    "check": "tsc --noEmit",
    "fmt": "prettier --write \"{src,e2e}/**/*.ts\"",
    "fmt:check": "prettier --check \"{src,e2e}/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:nanopass": "vitest run e2e/nanopass",
    "test:ssa": "vitest run e2e/ssa",
    "example:nanopass": "node e2e/nanopass/example.ts",
    "bench:nanopass": "node --expose-gc e2e/nanopass/bench.ts",
    "bench:ssa": "node --expose-gc e2e/ssa/bench.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
